<Window x:Class="ConvertAvifGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ConvertAvif GUI" Height="600" Width="800"
        Closed="Window_Closed">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Settings -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="ソースディレクトリ:" Margin="0,0,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SourceDirTextBox" Grid.Column="0" VerticalContentAlignment="Center"/>
                <Button x:Name="BrowseButton" Content="参照..." Grid.Column="1" Margin="5,0,0,0" Padding="10,2" Click="BrowseButton_Click"/>
            </Grid>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,10">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="拡張子 (カンマ区切り):"/>
                <TextBox x:Name="ExtensionsTextBox"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Quality:"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="QualitySlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="QualityTextBox" Grid.Column="1" VerticalContentAlignment="Center" Text="{Binding Value, ElementName=QualitySlider, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="評価モード:"/>
                <ComboBox x:Name="EvaluationModeComboBox" SelectedIndex="0" SelectionChanged="EvaluationModeComboBox_SelectionChanged">
                    <ComboBoxItem Content="SSIM"/>
                    <ComboBoxItem Content="Ssimulacra2"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock x:Name="ThresholdLabel" Text="SSIM 閾値:"/>
                <TextBox x:Name="SsimTextBox"/>
            </StackPanel>
            <StackPanel Margin="0,5,10,0">
                <TextBlock Text="並列実行数:"/>
                <TextBox x:Name="ParallelTextBox"/>
            </StackPanel>
            <StackPanel Margin="0,5,10,0">
                <TextBlock Text="エンジン:"/>
                <ComboBox x:Name="EngineComboBox" SelectedIndex="0" SelectionChanged="EngineComboBox_SelectionChanged">
                    <ComboBoxItem Content="Magick"/>
                    <ComboBoxItem Content="AvifEnc"/>
                </ComboBox>
            </StackPanel>
        </UniformGrid>

        <!-- AvifEnc Settings -->
        <Grid Grid.Row="2" x:Name="AvifEncSettingsGroup" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="avifenc パス:"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AvifEncPathTextBox" Grid.Column="0" VerticalContentAlignment="Center"/>
                    <Button x:Name="AvifEncBrowseButton" Content="..." Grid.Column="1" Margin="5,0,0,0" Padding="5,0" Click="AvifEncBrowseButton_Click"/>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="avifenc オプション:"/>
                <TextBox x:Name="AvifEncOptionsTextBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="avifenc プロセス優先度:"/>
                <ComboBox x:Name="PriorityComboBox" SelectedIndex="0">
                    <ComboBoxItem Content="低"/>
                    <ComboBoxItem Content="通常以下"/>
                    <ComboBoxItem Content="通常"/>
                    <ComboBoxItem Content="通常以上"/>
                    <ComboBoxItem Content="高"/>
                    <ComboBoxItem Content="リアルタイム"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Ssimulacra2 Settings -->
        <Grid Grid.Row="3" x:Name="Ssimulacra2SettingsGroup" Margin="0,0,0,10" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="ssimulacra2 パス:"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Ssimulacra2PathTextBox" Grid.Column="0" VerticalContentAlignment="Center"/>
                    <Button x:Name="Ssimulacra2BrowseButton" Content="参照..." Grid.Column="1" Margin="5,0,0,0" Padding="10,2" Click="Ssimulacra2BrowseButton_Click"/>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Actions -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
            <Button x:Name="ConvertButton" Content="変換開始" Width="100" Padding="5" Margin="0,0,10,0" Click="ConvertButton_Click"/>
            <Button x:Name="CancelButton" Content="キャンセル" Width="100" Padding="5" IsEnabled="False" Click="CancelButton_Click"/>
        </StackPanel>

        <!-- Results / Failure List -->
        <GroupBox Grid.Row="5" Header="変換結果 / 失敗したファイル">
            <ListView x:Name="FailureListView" GridViewColumnHeader.Click="GridViewColumnHeader_Click">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ファイル名" DisplayMemberBinding="{Binding InputPath}" Width="400"/>
                        <GridViewColumn Header="成功" DisplayMemberBinding="{Binding IsSuccess}" Width="100"/>
                        <GridViewColumn Header="メッセージ" DisplayMemberBinding="{Binding ErrorMessage}" Width="250"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <!-- Progress -->
        <StackPanel Grid.Row="6" Margin="0,10,0,0">
            <ProgressBar x:Name="ConversionProgressBar" Height="20" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="StatusTextBlock" Text="準備完了" Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>
